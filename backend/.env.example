# ============================================================================
# Podcast Digester — 环境变量示例
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================================

# ---- 运行环境 ----
ENV=development
# 绑定地址 / 端口（前端默认通过 Vite 代理到 :8000）
PODCAST_DIGESTER_HOST=127.0.0.1
PODCAST_DIGESTER_PORT=8000
PODCAST_DIGESTER_LOG_LEVEL=INFO

# ---- LLM（必填）----
# 支持多 provider，仅 2 种协议：openai_compatible / anthropic_compatible
# provider 预设见 app/llm/config.py:PROVIDERS（deepseek/openai/anthropic/glm/qwen/doubao/moonshot）
# 正式变量用 LLM_*；DEEPSEEK_* 为向后兼容别名（二选一即可，LLM_* 优先）

# provider 预设名（决定默认 base_url / model / 协议推断）
LLM_PROVIDER=deepseek
# 显式覆盖协议（留空则按 LLM_PROVIDER 推断）：openai_compatible | anthropic_compatible
# LLM_PROVIDER_TYPE=

# API Key（必填）
LLM_API_KEY=
# 端点；留空则用 provider 预设或 SDK 官方默认
# LLM_BASE_URL=https://api.deepseek.com
# 模型名（deepseek-chat 旧名 2026/07/24 下线、端点已 400 拒收；用 v4-flash，
# 非思考行为由 adapter 注入 thinking:disabled 复现。可选 v4-pro）
LLM_MODEL=deepseek-v4-flash

# ---- DEEPSEEK_* 旧变量（向后兼容别名，可继续用；与 LLM_* 同时存在时 LLM_* 优先）----
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 管理接口（可选）----
# 设置后，管理类接口需要带此 token；留空则不鉴权（仅本地单用户场景）
PODCAST_DIGESTER_ADMIN_TOKEN=

# ---- 成本 / 容量保护 ----
# 单集 LLM 花费上限（美元），超过则中止
PODCAST_DIGESTER_MAX_LLM_COST=5.0
# 单集时长上限（小时）
PODCAST_DIGESTER_MAX_EPISODE_HOURS=5.0

# ---- 网络（中国大陆访问 YouTube 等需要）----
# launchd 托管的服务不会自动继承 shell 代理；如需走代理在此配置或写入 plist
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# ---- ASR（可选调优；默认即可）----
# 无平台字幕时回退到 Apple AFM 3 语音识别，下列为轮询/超时相关参数
PODCAST_DIGESTER_ASR_MAX_WAIT=300

# ---- 字幕 LLM 纠错（可选；默认关）----
# pipeline 在 polish 前用 LLM 纠正 ASR 同音字/专有名词错误（如「预知面→月之暗面」），
# 用 episode.title + description 当术语表上下文。每集 +~100s LLM 耗时和费用，
# 故默认关闭；手动端点 POST /api/episodes/{id}/correct-transcript 不受此开关影响。
# PODCAST_DIGESTER_LLM_CORRECT_TRANSCRIPT=false

# ---- Worker 下载重试（可选；默认值见下）----
# 仅对临时性下载错误（CDN 节点不可达 / 限流 / 网络抖动，由 ytdlp_runner 分类为
# DownloadTemporaryError）生效。永久错误（URL 无效 / 视频删除）不重试，直接 failed。
# yt-dlp 内部已有 3-client × 10-fragment 重试（comma-join player_client），能漏到
# worker 这一层还抛临时错的，多为持续抽风，等一会再试有希望。
# PODCAST_DIGESTER_WORKER_MAX_DOWNLOAD_RETRIES=3
# 退避基数（秒），按 2^retry_count 指数增长：10s → 20s → 40s
# PODCAST_DIGESTER_WORKER_RETRY_BACKOFF=10
